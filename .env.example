CANVAS_BASE_URL=https://your-district.instructure.com
CANVAS_ACCESS_TOKEN=paste-your-personal-access-token-here

# Required only for hosted HTTP mode. Generate a long random value.
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

CANVAS_WRITE_MODE=student

# Optional. Used to make stable teacher mode student aliases.
# If omitted, MCP_AUTH_TOKEN is used remotely and CANVAS_ACCESS_TOKEN locally.
CANVAS_REDACTION_KEY=
CANVAS_MAX_PAGES=20
CANVAS_TIMEOUT_MS=30000
