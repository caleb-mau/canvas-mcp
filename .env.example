CANVAS_BASE_URL=https://your-district.instructure.com
CANVAS_ACCESS_TOKEN=paste-your-personal-access-token-here

# Required for hosted mode. Generate a long random value.
# ChatGPT's OAuth authorization page asks you for this same secret once.
# Other MCP clients may also use it directly as a Bearer token.
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

CANVAS_WRITE_MODE=student

# Safety default. Submission, grading, messaging, discussion posts, and raw
# mutating API calls ask the end user for confirmation before changing Canvas.
CANVAS_REQUIRE_CONFIRMATION=true

# Optional. Used to make stable teacher mode student aliases.
# If omitted, MCP_AUTH_TOKEN is used remotely and CANVAS_ACCESS_TOKEN locally.
CANVAS_REDACTION_KEY=
CANVAS_MAX_PAGES=20
CANVAS_TIMEOUT_MS=30000

# Maximum size for files downloaded from MCP file references before Canvas upload.
CANVAS_MAX_REMOTE_FILE_MB=50
